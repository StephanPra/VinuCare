# Google Sign-In (OAuth Client ID, "Web application" type)
# Get it from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=864982798962-vf2tp6226da7304f40p8llusdighvnih.apps.googleusercontent.com

# Home page map runs on Leaflet + OpenStreetMap (src/components/LeafletMap.jsx)
# — no API key needed, nothing to configure here.

# Backend API base URL. Empty/unset = defaults to http://localhost:5000
# for local dev. Set this to your real deployed backend URL (e.g.
# https://api.vinucare.com) before publishing, or every API call the
# frontend makes will try to reach localhost and fail for every visitor.
VITE_API_BASE_URL=
